          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "state",
        "decision",
        "approval",
        "task",
        "handoff",
        "report",
        "acknowledgment"
      ]
