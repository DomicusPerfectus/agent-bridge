{
  "$id": "urn:agent-bridge:protocol:0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "state"
          }
        }
      },
      "then": {
        "properties": {
          "in_reply_to": {
            "type": "null"
          },
          "payload": {
            "additionalProperties": false,
            "properties": {
              "blockers": {
                "items": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "type": "array"
              },
              "next_action": {
                "type": "string"
              },
              "risks": {
                "items": {
                  "pattern": "\\S",
                  "type": "string"
                },
