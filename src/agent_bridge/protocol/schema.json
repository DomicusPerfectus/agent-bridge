              "blockers": {
                "items": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "type": "array"
              },
              "next_action": {
                "type": "string"
              },
              "result": {
                "pattern": "\\S",
                "type": "string"
              },
              "risks": {
                "items": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "result",
              "artifacts",
              "blockers",
              "risks",
              "next_action"
