            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}(?![\\s\\S])",
            "type": "string"
          },
          "in_reply_to": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
            "type": "string"
          },
          "payload": {
            "additionalProperties": false,
            "properties": {},
            "required": [],
            "type": "object"
          },
          "status": {
            "enum": [
              "acknowledged"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          },
          "payload": {
            "properties": {
              "requires_approval": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "awaiting_approval"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          },
          "payload": {
            "properties": {
              "requires_approval": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      }
    }
