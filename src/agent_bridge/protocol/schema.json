            "additionalProperties": false,
            "properties": {
              "blockers": {
                "items": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "type": "array"
              },
              "context": {
                "type": "object"
              },
              "instructions": {
                "pattern": "\\S",
                "type": "string"
              },
              "next_action": {
                "type": "string"
              },
              "risks": {
                "items": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "instructions",
              "context",
              "blockers",
              "risks",
              "next_action"
