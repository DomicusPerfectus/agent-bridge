  "required": [
    "protocol_version",
    "message_id",
    "project_id",
    "kind",
    "source",
    "destination",
    "correlation_id",
    "task_id",
    "in_reply_to",
    "timestamp",
    "status",
    "summary",
    "payload",
    "extensions"
  ],
  "title": "Agent Bridge v0.1 message",
  "type": "object"
}
