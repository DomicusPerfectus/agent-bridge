          "destination": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}(?![\\s\\S])",
            "type": "string"
          },
          "in_reply_to": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
            "type": "string"
          },
          "payload": {
            "additionalProperties": false,
            "properties": {
              "artifacts": {
                "items": {
                  "pattern": "\\S",
                  "type": "string"
