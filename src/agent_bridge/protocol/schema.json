                },
                "type": "array",
                "uniqueItems": true
              },
              "description": {
                "pattern": "\\S",
                "type": "string"
              },
              "title": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "title",
              "description",
              "approval_ids"
