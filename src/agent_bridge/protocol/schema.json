              "blocked"
            ]
          },
          "task_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "destination": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}(?![\\s\\S])",
            "type": "string"
          },
          "in_reply_to": {
            "type": "null"
