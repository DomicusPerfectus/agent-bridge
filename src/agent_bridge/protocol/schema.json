          },
          "status": {
            "enum": [
              "accepted",
              "awaiting_approval"
            ]
          },
          "task_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "approval"
          }
        }
      },
      "then": {
        "properties": {
